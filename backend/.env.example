# --- LLM provider (pick one; provider name drives which client is built) ---
LLM_PROVIDER=google_genai          # openai | anthropic | google_genai
LLM_MODE="gemini-3.5-flash-lite"

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=AQ.Ab8RN6JQ0AMhu6Dx6ZbCG6gvyHohGUSPekABfcTtB2qPQy_kbw

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=financial_child_chunks

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=20
MIN_RELEVANCE_SCORE=0.35

# --- Reranker (BGE Reranker v2) ---
ENABLE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=5

# --- Local parent-chunk store (sqlite for now, swapped for Postgres in phase 4) ---
PARENT_STORE_PATH=./parent_store.db
